# Supabase project settings (Project Settings -> API in the Supabase dashboard)
# Copy this file to .env.local and fill in the values. Never commit real values.

# The Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key. Safe for the browser — it is subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your app's public URL — used to build absolute links that must be correct
# even when generated server-side (signup confirmation emails, password
# reset emails, the public join link and its QR code, shareable worship
# document links). On Vercel this is optional: it's auto-detected from
# VERCEL_PROJECT_PRODUCTION_URL/VERCEL_URL if left unset. Set it explicitly
# here only if you're on a custom domain or hosting elsewhere. Falls back to
# http://localhost:3000 outside of Vercel and outside of production.
NEXT_PUBLIC_SITE_URL=

# Secret ("service_role") key — Project Settings -> API. NEVER exposes this
# to the browser; only used server-side, and only by trusted machinery with
# no user session to act under (currently: the Instagram token-refresh cron).
# Bypasses Row Level Security entirely, so do not reuse it anywhere else.
SUPABASE_SERVICE_ROLE_KEY=

# Instagram API with Instagram Login (Meta app dashboard -> your app ->
# Instagram -> API setup with Instagram login). App ID/Secret are shown on
# that product's settings page, separate from the Meta app's own top-level
# ID/secret. Required for the Instagram page in the dashboard.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Arbitrary random string of your choosing. Set the same value as this
# project's Vercel Cron secret (Vercel sets it automatically for crons
# defined in vercel.json) so the token-refresh cron route can verify a
# request actually came from Vercel and not a random caller. Optional in
# local dev — the route allows unauthenticated calls if this is unset.
CRON_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client
# ID (Web application). Enable the "YouTube Data API v3" and "YouTube
# Analytics API" for the project first. Add
# {NEXT_PUBLIC_SITE_URL}/api/youtube/callback as an authorized redirect URI.
# Required for the YouTube page in the dashboard.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Standard Facebook Login (Meta app dashboard -> your app -> Settings ->
# Basic). This is the Meta app's own top-level App ID/Secret — NOT the
# Instagram API product's separate credentials above, even though both can
# live on the same Meta app. Add {NEXT_PUBLIC_SITE_URL}/api/facebook/callback
# as a valid OAuth redirect URI under Facebook Login -> Settings. Required
# for the Facebook page in the dashboard.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Resend (resend.com) — unlike Instagram/YouTube/Facebook this isn't a
# per-org OAuth connection, just one app-wide sending account. Verify a
# sending domain in the Resend dashboard first, then EMAIL_FROM_ADDRESS
# must be an address on that domain (e.g. updates@yourchurchapp.com).
# Each org's display name is used as the "from" name automatically.
# Required for the Email page in the dashboard.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# A secret you choose yourself when creating the webhook in the Resend
# Dashboard (Webhooks -> Add Endpoint -> URL:
# {NEXT_PUBLIC_SITE_URL}/api/resend/webhook -> select the delivered,
# bounced, delivery_delayed, complained, and failed events -> copy the
# Signing Secret shown there into this var). Reports async delivery
# failures (bounces, spam complaints) that a successful send call can't
# see on its own — these land in message_delivery_events and, on failure,
# the Super Admin Logs page. Optional: without it, sends still work, you
# just won't hear about a bounce after the fact.
RESEND_WEBHOOK_SECRET=

# Twilio (twilio.com) — the shared SMS provider, app-wide like Resend
# above (no per-org "bring your own Twilio"). TWILIO_ACCOUNT_SID and
# TWILIO_AUTH_TOKEN come from the Twilio Console. For the sender, prefer
# TWILIO_MESSAGING_SERVICE_SID (a Messaging Service — required for
# compliant bulk sending to US numbers under A2P 10DLC) over
# TWILIO_FROM_NUMBER (a single purchased phone number); only one is
# required. Required for the SMS page in the dashboard.
#
# Every SMS/WhatsApp send already points Twilio at
# {NEXT_PUBLIC_SITE_URL}/api/twilio/status-callback (no separate setup or
# env var needed) — that's what reports async delivery failures (a number
# that bounced, a WhatsApp sandbox recipient who never joined) back into
# message_delivery_events and the Super Admin Logs page. It only works
# once NEXT_PUBLIC_SITE_URL (or Vercel's own URL) is actually reachable by
# Twilio, so it won't fire against a plain localhost dev server.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# The shared-mode WhatsApp sender for the WhatsApp page — same Twilio
# account as above (TWILIO_ACCOUNT_SID/AUTH_TOKEN), but a WhatsApp-enabled
# sender is a different resource from the SMS number/Messaging Service, so
# it needs its own number here (from Twilio's WhatsApp sender setup, e.g.
# the WhatsApp Sandbox for testing or an approved sender for production).
# An organization can instead connect its own Twilio account (Team ->
# WhatsApp page -> Connect), which doesn't use this var at all — this one
# only matters for orgs using the shared service.
TWILIO_WHATSAPP_FROM_NUMBER=

# Razorpay (razorpay.com) — powers subscription billing for the Basic/
# Premium/Pro plans (src/lib/plans/config.ts). This SAME account is also
# used for Fund Raiser "shared service" giving links (src/lib/finance/
# razorpay-giving.ts) — a fundraiser set to "Own Razorpay account" instead
# uses credentials the church enters themselves (Fund Raiser page ->
# connect Razorpay -> stored in organization_razorpay_accounts), not these
# vars. Key ID/Secret are under Settings -> API Keys in the Razorpay
# Dashboard (test mode keys work the same way as live ones).
# NEXT_PUBLIC_RAZORPAY_KEY_ID is the same Key ID, duplicated with the
# public prefix because the Checkout popup runs client-side and needs it
# in the browser bundle.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# A secret you choose yourself when creating the webhook in the Razorpay
# Dashboard (Settings -> Webhooks -> add
# {NEXT_PUBLIC_SITE_URL}/api/razorpay/webhook as the URL, subscribe to the
# subscription.* events AND payment.captured, and set this same secret
# there). Used to verify that a webhook request actually came from
# Razorpay. payment.captured is a backup confirmation path for "shared"-
# mode Fund Raiser giving links only — "own"-mode links (a different,
# church-owned Razorpay account) rely solely on the Checkout success
# callback, since there's no webhook configured on their account pointing
# back to this app.
RAZORPAY_WEBHOOK_SECRET=

# Comma-separated list of email addresses allowed into /platform-admin —
# the Super Admin dashboard: every tenant and its subscription, comping a
# plan or extending a trial, a cross-org support ticket inbox, the shared
# Fund Raiser payout ledger, integration/health status, and an in-app
# event log (src/lib/platform-events/log.ts). There's no cross-organization
# "platform staff" role in this app otherwise, so this is a plain allowlist
# rather than a full role system.
PLATFORM_ADMIN_EMAILS=

# Optional — powers the "Production deployment" card on the Super Admin
# Health page (src/lib/platform-admin/vercel.ts). Generate a token at
# vercel.com -> Account Settings -> Tokens; VERCEL_PROJECT_ID is on the
# project's own Settings page. VERCEL_TEAM_ID is only needed if this
# project lives under a Vercel team rather than a personal account. Left
# unset, that card just shows "Not connected" instead of erroring.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Optional — powers the "Supabase project" card (disk usage + per-service
# health) on the same Health page (src/lib/platform-admin/supabase-
# management.ts). Generate a Personal Access Token at supabase.com ->
# Account -> Access Tokens. The project ref is parsed from
# NEXT_PUBLIC_SUPABASE_URL above, so no separate ref var is needed. Left
# unset, that card just shows "Not connected" instead of erroring.
SUPABASE_MANAGEMENT_API_TOKEN=

# Razorpay Plan IDs (plan_xxxxxxxxxxxxxx) — one per app tier per billing
# interval (monthly, and annual at 10% off), each a fixed amount/period
# that a Subscription is created against. Run
# `node scripts/create-razorpay-plans.mjs` once (after setting the two
# RAZORPAY_KEY_* vars above) to create all six and print their IDs.
RAZORPAY_PLAN_ID_BASIC=
RAZORPAY_PLAN_ID_BASIC_ANNUAL=
RAZORPAY_PLAN_ID_PREMIUM=
RAZORPAY_PLAN_ID_PREMIUM_ANNUAL=
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_PRO_ANNUAL=
